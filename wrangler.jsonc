{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "r2-explorer",
  "main": "worker/index.js",
  "compatibility_date": "2024-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "bucketwestnorthamerica"
    }
  ],
  "vars": {
    "PUBLIC_DOMAIN": "https://bucketwna.505250.xyz",
    "APP_PASSWORD": ""
  },
  "routes": [
    {
      "pattern": "r2.505250.xyz",
      "custom_domain": true
    }
  ]
}
